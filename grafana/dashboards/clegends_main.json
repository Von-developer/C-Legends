        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showMeasure": false,
          "showScale": false,
          "showZoom": true
        },
        "layers": [
          {
            "type": "basemap",
            "name": "Base map",
            "config": {
              "showLabels": true
            },
            "opacity": 1,
            "filterData": {}
          },
          {
            "type": "markers",
            "name": "IP Hits",
            "config": {
              "color": {
                "fixed": "#F2495C"
              },
              "fillOpacity": 0.6,
              "shape": "circle",
              "showLegend": true,
              "size": {
                "fixed": 12,
                "min": 4,
                "max": 30
              }
            },
            "location": {
              "mode": "auto",
              "latitude": "lat",
              "longitude": "lon"
            },
            "tooltip": true
          }
        ],
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "10.0.0",
      "title": "Live IP Geolocation Map",
      "description": "Each dot = a source IP from your log stream. Red = Error, Yellow = Warning, Green = Login/Activity.",
      "type": "geomap",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "clegends-prometheus"
          },
          "expr": "clegends_geo_hit",
          "legendFormat": "{{city}} ({{cc}}) \u2014 {{type}}",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "rows",
            "keepLabels": [
              "lat",
              "lon",
              "city",
              "cc",
              "type"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "lat": "latitude",
              "lon": "longitude"
            }
          }
        }
      ]
    },
