      "options": {
        "frameIndex": 0,
        "showHeader": true,
        "fontSize": 14,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      },
      "title": "Top Source Countries",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "clegends-prometheus"
          },
          "expr": "sort_desc(sum by (cc, city) (clegends_event_total))",
          "legendFormat": "{{cc}} / {{city}}",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
